# ==========================================
# Brandit Environment Configuration (.env.example)
# Never commit real credentials or .env files.
# ==========================================

# Server-only MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.hbsxug5.mongodb.net/brandit?retryWrites=true&w=majority

# JWT Authentication Secret for Admin Sessions (minimum 32 random characters)
JWT_SECRET=replace_with_a_secure_random_session_secret_32_chars_min

# Initial Provisioning Credentials for First Admin Setup
ADMIN_INITIAL_EMAIL=admin@brandit.agency
ADMIN_INITIAL_PASSWORD=replace_with_secure_initial_admin_password

# Email Notifications Destination
ENQUIRY_NOTIFICATION_EMAIL=info@brandit.agency
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brandit Notifications <no-reply@brandit.agency>"

# Media & CV Storage Configuration
# local (stored on server disk under protected directory) or s3-compatible provider
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads

# Vercel Blob Storage Token (Optional for cloud storage in production; falls back to local disk if omitted)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Public Site URL
SITE_URL=http://localhost:8080
